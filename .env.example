# Copy this file to ".env" (same folder as app.py) and adjust the values.
# Numbers only - no units. Measure these on YOUR vehicle; wrong values = wrong distances.

CAM_HEIGHT = 1.2        # metres from the road surface to the camera lens (allowed 0.2 - 5)
PITCH_DEG = 25          # downward tilt of the camera in degrees; 0 = level with the horizon (allowed -10 - 80)
VFOV_DEG = 48.8         # vertical field of view in degrees (Pi Camera v2 ~48.8, v3 ~41; USB cams vary) (allowed 10 - 120)

# Optional: force the simulated GPS even on Linux (handy for testing indoors).
# FAKE_GPS = 1